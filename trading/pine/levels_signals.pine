//@version=6
// Уровни и сигналы: пробой → BUY/SELL, ретест, разворот фитилём, ловушка, свечные модели.
// Работает на любом графике TradingView (OANDA:XAUUSD и др.), цена — та, что на графике.
indicator("Уровни и сигналы", overlay = true, max_lines_count = 200, max_labels_count = 400)

// ───────── настройки ─────────
pivLen    = input.int(10, "Сила свинга (свечей слева/справа)", minval = 2)
htfTf     = input.timeframe("60", "Старший ТФ для тренда")
zoneMult  = input.float(0.3, "Ширина зоны уровня, ×ATR", step = 0.05)
mergeMult = input.float(0.6, "Склеивать уровни ближе, ×ATR", step = 0.1)
minRR     = input.float(1.5, "Мин. прибыль/риск", step = 0.1)
retestMax = input.int(24, "Ждать ретест, свечей", minval = 3)
showRange = input.float(25, "Показывать уровни в пределах, ×ATR")
showPat   = input.string("у уровней", "Свечные модели", options = ["у уровней", "все", "выкл"])
showWeak  = input.bool(true, "Показывать слабые сигналы (серые)")

atrV = ta.atr(14)

// ───────── тренд старшего ТФ и уровни прошлого дня (без перерисовки) ─────────
[htfC, htfE, htfE5] = request.security(syminfo.tickerid, htfTf, [close[1], ta.ema(close, 50)[1], ta.ema(close, 50)[6]], lookahead = barmerge.lookahead_on)
trend = htfC > htfE and htfE > htfE5 ? 1 : htfC < htfE and htfE < htfE5 ? -1 : 0
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)

// ───────── хранилище уровней ─────────
var lvPrice  = array.new<float>()
var lvTouch  = array.new<int>()
var lvBroken = array.new<int>()     // 1 — пробит вверх, -1 — вниз, 0 — нет
var lvBrBar  = array.new<int>()
var lvExt    = array.new<float>()   // экстремум после пробоя (для стопа ловушки)
var lvCool   = array.new<int>()
var lvTag    = array.new<string>()

f_remove(int i) =>
    array.remove(lvPrice, i)
    array.remove(lvTouch, i)
    array.remove(lvBroken, i)
    array.remove(lvBrBar, i)
    array.remove(lvExt, i)
    array.remove(lvCool, i)
    array.remove(lvTag, i)

f_add(float p, int w, string tag) =>
    int found = -1
    int n = array.size(lvPrice)
    if n > 0
        for i = 0 to n - 1
            if math.abs(array.get(lvPrice, i) - p) <= mergeMult * atrV
                found := i
                break
    if found >= 0
        t = array.get(lvTouch, found)
        array.set(lvPrice, found, (array.get(lvPrice, found) * t + p * w) / (t + w))
        array.set(lvTouch, found, t + w)
        if tag != "swing"
            array.set(lvTag, found, tag)
    else
        array.push(lvPrice, p)
        array.push(lvTouch, w)
        array.push(lvBroken, 0)
        array.push(lvBrBar, 0)
        array.push(lvExt, 0.0)
        array.push(lvCool, -100)
        array.push(lvTag, tag)
        if array.size(lvPrice) > 24
            f_remove(0)

ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
if not na(ph) and not na(atrV)
    f_add(ph, 1, "swing")
if not na(pl) and not na(atrV)
    f_add(pl, 1, "swing")
if not na(pdh) and pdh != pdh[1] and not na(atrV)
    f_add(pdh, 2, "макс. вчера")
    f_add(pdl, 2, "мин. вчера")

// ближайший уровень за ценой — цель для тейка
f_next(float price, int dir, float z) =>
    float best = na
    n = array.size(lvPrice)
    if n > 0
        for j = 0 to n - 1
            q = array.get(lvPrice, j)
            if dir > 0 and q - z > price and (na(best) or q - z < best)
                best := q - z
            if dir < 0 and q + z < price and (na(best) or q + z > best)
                best := q + z
    best

// ───────── свечные модели ─────────
body  = math.abs(close - open)
rng   = math.max(high - low, syminfo.mintick)
upW   = high - math.max(open, close)
loW   = math.min(open, close) - low
body1 = math.abs(close[1] - open[1])
body2 = math.abs(close[2] - open[2])
morning = close[2] < open[2] and body2 >= 0.6 * atrV and body1 <= 0.35 * body2 and close > open and close > (open[2] + close[2]) / 2
evening = close[2] > open[2] and body2 >= 0.6 * atrV and body1 <= 0.35 * body2 and close < open and close < (open[2] + close[2]) / 2
bullEng = close[1] < open[1] and close > open and close >= open[1] and open <= close[1] and body > body1 and body >= 0.5 * atrV
bearEng = close[1] > open[1] and close < open and close <= open[1] and open >= close[1] and body > body1 and body >= 0.5 * atrV
hammer  = rng >= 0.6 * atrV and loW >= 2 * body and loW >= 0.6 * rng and upW <= 0.25 * rng
shStar  = rng >= 0.6 * atrV and upW >= 2 * body and upW >= 0.6 * rng and loW <= 0.25 * rng
patDir  = morning or bullEng or hammer ? 1 : evening or bearEng or shStar ? -1 : 0
patName = morning ? "Утр. звезда" : evening ? "Веч. звезда" : bullEng or bearEng ? "Поглощение" : hammer ? "Молот" : shStar ? "Пин-бар" : ""
volOk   = volume > 1.3 * ta.sma(volume, 20)

// ───────── сделка, за которой следим ─────────
var int   tDir = 0
var float tEntry = na
var float tSL = na
var float tTP = na
var int   tBar = na
var string tName = ""
var string tGrade = ""
var string tWhy = ""
var string tRes = ""
var int   nTP = 0
var int   nSL = 0
var line  lnE = na
var line  lnS = na
var line  lnT = na

if barstate.isconfirmed and tRes == "open" and bar_index > tBar
    hitSL = tDir > 0 ? low <= tSL : high >= tSL
    hitTP = tDir > 0 ? high >= tTP : low <= tTP
    if hitSL
        tRes := "sl"
        nSL += 1
    else if hitTP
        tRes := "tp"
        nTP += 1

// ───────── поиск сигнала на закрытой свече ─────────
bool   fired = false
int    sDir = 0
float  sSL = na
string sKind = ""
string sName = ""
int    sLv = -1
bool   nearSup = false
bool   nearRes = false
z = zoneMult * atrV

if barstate.isconfirmed and array.size(lvPrice) > 0 and not na(atrV)
    for i = 0 to array.size(lvPrice) - 1
        p  = array.get(lvPrice, i)
        up = p + z
        dn = p - z
        st = array.get(lvBroken, i)
        coolOk = bar_index - array.get(lvCool, i) >= 6
        impulse = body >= 0.5 * rng and body >= 0.5 * atrV
        wickMin = math.max(1.5 * body, 0.4 * rng, 0.35 * atrV)
        if math.abs(low - p) <= z + 0.25 * atrV
            nearSup := true
        if math.abs(high - p) <= z + 0.25 * atrV
            nearRes := true
        if fired
            continue
        if st != 0
            array.set(lvExt, i, st > 0 ? math.max(array.get(lvExt, i), high) : math.min(array.get(lvExt, i), low))
            if bar_index - array.get(lvBrBar, i) > retestMax
                array.set(lvBroken, i, 0)
            else if st > 0 and close < dn
                array.set(lvBroken, i, 0)
                if coolOk
                    fired := true
                    sDir := -1
                    sKind := "trap"
                    sName := "Ловушка → SELL"
                    sSL := array.get(lvExt, i) + 0.2 * atrV
                    sLv := i
            else if st < 0 and close > up
                array.set(lvBroken, i, 0)
                if coolOk
                    fired := true
                    sDir := 1
                    sKind := "trap"
                    sName := "Ловушка → BUY"
                    sSL := array.get(lvExt, i) - 0.2 * atrV
                    sLv := i
            else if st > 0 and bar_index > array.get(lvBrBar, i) and low <= up and close > p and (close >= open or loW >= body)
                array.set(lvBroken, i, 0)
                fired := true
                sDir := 1
                sKind := "retest"
                sName := "Ретест → BUY"
                sSL := math.min(low, dn) - 0.25 * atrV
                sLv := i
            else if st < 0 and bar_index > array.get(lvBrBar, i) and high >= dn and close < p and (close <= open or upW >= body)
                array.set(lvBroken, i, 0)
                fired := true
                sDir := -1
                sKind := "retest"
                sName := "Ретест → SELL"
                sSL := math.max(high, up) + 0.25 * atrV
                sLv := i
        else
            if close[1] <= up and close > up + 0.1 * atrV and impulse and close > open
                array.set(lvBroken, i, 1)
                array.set(lvBrBar, i, bar_index)
                array.set(lvExt, i, high)
                if coolOk
                    fired := true
                    sDir := 1
                    sKind := "breakout"
                    sName := "Пробой ▲ → BUY"
                    sSL := dn - 0.3 * atrV
                    sLv := i
            else if close[1] >= dn and close < dn - 0.1 * atrV and impulse and close < open
                array.set(lvBroken, i, -1)
                array.set(lvBrBar, i, bar_index)
                array.set(lvExt, i, low)
                if coolOk
                    fired := true
                    sDir := -1
                    sKind := "breakout"
                    sName := "Пробой ▼ → SELL"
                    sSL := up + 0.3 * atrV
                    sLv := i
            else if close[1] < up and high >= dn and close < p and upW >= wickMin and coolOk
                fired := true
                sDir := -1
                sKind := high > up ? "sweep" : "wick"
                sName := high > up ? "Ложный пробой → разворот SELL" : "Разворот → SELL"
                sSL := math.max(high, up) + 0.2 * atrV
                sLv := i
            else if close[1] > dn and low <= up and close > p and loW >= wickMin and coolOk
                fired := true
                sDir := 1
                sKind := low < dn ? "sweep" : "wick"
                sName := low < dn ? "Ложный пробой → разворот BUY" : "Разворот → BUY"
                sSL := math.min(low, dn) - 0.2 * atrV
                sLv := i

if fired
    entry = close
    risk = math.abs(entry - sSL)
    if risk > 0
        tp0 = f_next(entry, sDir, z)
        tp = na(tp0) or math.abs(tp0 - entry) < 0.3 * risk ? entry + sDir * 2 * risk : tp0
        rr = math.abs(tp - entry) / risk
        touches = array.get(lvTouch, sLv)
        why = ""
        sc = 1
        if touches >= 2
            sc += 1
            why += "+ уровень, касаний " + str.tostring(touches) + "\n"
        if touches >= 3
            sc += 1
        if trend == sDir
            sc += 1
            why += "+ по тренду старшего ТФ\n"
        else if trend == -sDir
            sc -= 1
            why += "− против тренда старшего ТФ\n"
        if patDir == sDir
            sc += 1
            why += "+ свечная модель: " + patName + "\n"
        if sKind == "sweep" or sKind == "trap"
            sc += 1
            why += "+ сняли стопы (ложный пробой)\n"
        if volOk
            sc += 1
            why += "+ повышенный объём\n"
        if rr >= 2
            sc += 1
        if rr < minRR
            sc -= 3
            why += "− до следующего уровня мало места\n"
        grade = sc >= 4 ? "Сильный" : sc >= 2 ? "Нормальный" : "Слабый — пропустить"
        weak = sc < 2
        array.set(lvCool, sLv, bar_index)
        if not weak or showWeak
            txt = sName + (patDir == sDir ? " · " + patName : "") + (weak ? " (слабый)" : "")
            col = weak ? color.new(color.gray, 20) : sDir > 0 ? color.new(#16a34a, 0) : color.new(#dc2626, 0)
            label.new(bar_index, sDir > 0 ? low : high, txt, style = sDir > 0 ? label.style_label_up : label.style_label_down, color = col, textcolor = color.white, size = size.small,
                 tooltip = "Вход " + str.tostring(entry, format.mintick) + "\nСтоп " + str.tostring(sSL, format.mintick) + "\nТейк " + str.tostring(tp, format.mintick) + "\nП/Р " + str.tostring(rr, "#.0") + "\n" + grade + "\n" + why)
        if not weak
            tDir := sDir
            tEntry := entry
            tSL := sSL
            tTP := tp
            tBar := bar_index
            tName := sName
            tGrade := grade
            tWhy := why
            tRes := "open"
            line.delete(lnE)
            line.delete(lnS)
            line.delete(lnT)
            lnE := line.new(bar_index, entry, bar_index + 20, entry, color = color.blue, style = line.style_dashed)
            lnS := line.new(bar_index, sSL, bar_index + 20, sSL, color = color.orange, width = 2, style = line.style_dashed)
            lnT := line.new(bar_index, tp, bar_index + 20, tp, color = color.aqua, width = 2, style = line.style_dashed)
            alert((sDir > 0 ? "BUY " : "SELL ") + syminfo.ticker + ": " + sName + ". Вход " + str.tostring(entry, format.mintick) + ", стоп " + str.tostring(sSL, format.mintick) + ", тейк " + str.tostring(tp, format.mintick) + " (" + grade + ")", alert.freq_once_per_bar_close)

// свечные модели — там, где нет сигнала
if barstate.isconfirmed and not fired and patDir != 0 and showPat != "выкл"
    nearOk = showPat == "все" or (patDir > 0 and nearSup) or (patDir < 0 and nearRes)
    if nearOk
        label.new(bar_index, patDir > 0 ? low : high, patName, style = patDir > 0 ? label.style_label_up : label.style_label_down,
             color = color.new(color.black, 100), textcolor = patDir > 0 ? #86efac : #fca5a5, size = size.tiny)

// ───────── уровни на графике и табличка «Что делать сейчас» ─────────
var lvLines  = array.new<line>()
var lvLabels = array.new<label>()
var table panel = table.new(position.top_right, 1, 6, bgcolor = color.new(#111827, 5), border_width = 0, frame_color = #374151, frame_width = 1)

if barstate.islast and not na(atrV)
    for l in lvLines
        line.delete(l)
    for l in lvLabels
        label.delete(l)
    array.clear(lvLines)
    array.clear(lvLabels)
    float resP = na
    float supP = na
    string brkTxt = ""
    float nearP = na
    n = array.size(lvPrice)
    if n > 0
        for i = 0 to n - 1
            p = array.get(lvPrice, i)
            if math.abs(p - close) <= showRange * atrV
                t = array.get(lvTouch, i)
                isRes = p > close
                col = isRes ? #ef4444 : #22c55e
                array.push(lvLines, line.new(bar_index - 1, p, bar_index, p, extend = extend.both, color = color.new(col, t >= 3 ? 0 : 35), width = math.min(t, 3)))
                stars = t >= 3 ? "★★★" : t >= 2 ? "★★" : "★"
                array.push(lvLabels, label.new(bar_index + 4, p, str.tostring(p, format.mintick) + " " + stars + " " + array.get(lvTag, i), style = label.style_label_left, color = color.new(col, 70), textcolor = color.white, size = size.small))
                if isRes and (na(resP) or p < resP)
                    resP := p
                if not isRes and (na(supP) or p > supP)
                    supP := p
                if math.abs(close - p) <= z + 0.4 * atrV
                    nearP := p
            st = array.get(lvBroken, i)
            if st != 0
                brkTxt := (st > 0 ? "▲ ПРОБИЛИ " : "▼ ПРОБИЛИ ") + str.tostring(p, format.mintick) + (st > 0 ? " — направление BUY" : " — направление SELL") + "\nЛучший вход — на ретесте уровня"
    string head = "ЖДАТЬ"
    string body2txt = "Цена между уровнями — входа нет"
    color hc = color.yellow
    if tRes == "open" and bar_index - tBar <= 6
        head := tDir > 0 ? "▲ " + tName : "▼ " + tName
        body2txt := "Вход " + str.tostring(tEntry, format.mintick) + "   Стоп " + str.tostring(tSL, format.mintick) + "   Тейк " + str.tostring(tTP, format.mintick) + "\nСила: " + tGrade + "\n" + tWhy
        hc := tDir > 0 ? #22c55e : #ef4444
    else if brkTxt != ""
        head := brkTxt
        body2txt := "Не догоняй. Жди возврат к уровню и закрытие за ним"
        hc := str.contains(brkTxt, "BUY") ? #22c55e : #ef4444
    else if not na(nearP)
        head := "ЦЕНА У УРОВНЯ " + str.tostring(nearP, format.mintick)
        body2txt := "Смотри закрытие свечи:\nтень и закрытие обратно → разворот\nзакрытие телом за уровнем → пробой"
    trTxt = trend > 0 ? "вверх ▲" : trend < 0 ? "вниз ▼" : "боковик"
    table.cell(panel, 0, 0, "ЧТО ДЕЛАТЬ СЕЙЧАС", text_color = #9ca3af, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 0, 1, head, text_color = hc, text_size = size.large, text_halign = text.align_left)
    table.cell(panel, 0, 2, body2txt, text_color = color.white, text_size = size.normal, text_halign = text.align_left)
    table.cell(panel, 0, 3, "Сопротивление: " + (na(resP) ? "—" : str.tostring(resP, format.mintick)) + "   Поддержка: " + (na(supP) ? "—" : str.tostring(supP, format.mintick)), text_color = #d1d5db, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 0, 4, "Тренд " + htfTf + ": " + trTxt, text_color = #d1d5db, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 0, 5, "История сигналов: ✅ " + str.tostring(nTP) + "  ❌ " + str.tostring(nSL), text_color = #9ca3af, text_size = size.small, text_halign = text.align_left)
