{
  "name": "kachestvo-moyki",
  "productName": "Качество мойки УКПФ",
  "version": "1.0.0",
  "description": "Дашборд качества мойки УКПФ — приложение для Windows",
  "author": "АО «УКПФ»",
  "repository": {
    "type": "git",
    "url": "https://github.com/fraggerskill99-crypto/dashboard.git"
  },
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "node copy-dashboard.js && electron .",
    "dist": "node copy-dashboard.js && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "kz.ukpf.kachestvo-moyki",
    "productName": "Качество мойки УКПФ",
    "executableName": "KachestvoMoyki",
    "files": [
      "main.js",
      "dashboard.html",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Качество мойки",
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049",
      "artifactName": "kachestvo-moyki-setup.exe"
    },
    "portable": {
      "artifactName": "kachestvo-moyki-portable.exe"
    }
  }
}
